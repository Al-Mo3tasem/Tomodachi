{
  "name": "tomodachi",
  "version": "1.0.0",
  "description": "Tomodachi native shell (Capacitor) — the static web app in www/",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:www": "node scripts/native/build-www.mjs",
    "build:bridge": "node scripts/native/build-bridge.mjs",
    "native:sync": "npm run build:www && npx cap sync",
    "android:debug": "npm run native:sync && node scripts/native/gradle.mjs assembleDebug",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/native/collect-apk.mjs",
    "dev": "http-server -p 8744 -c-1",
    "test": "npm run lint:css && npm run lint:gates && npm run test:unit",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint:css": "node scripts/dev/lint-css.mjs",
    "lint:gates": "node scripts/dev/lint-gates.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Al-Mo3tasem/Tomodachi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Al-Mo3tasem/Tomodachi/issues"
  },
  "homepage": "https://github.com/Al-Mo3tasem/Tomodachi#readme",
  "private": true,
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/assets": "^3.0.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1"
  }
}
